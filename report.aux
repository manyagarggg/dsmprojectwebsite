\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.5}Water Quality: Ganga and Sangam Sensor Analysis (spatial\_analysis.ipynb, Section 11)}{25}{subsubsection.2.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Full time-series overview for both sensors (January 2019 to February 2020). Top panel: Water Quality Index (WQI, higher $=$ worse). Middle panel: conductivity ($\mu $S/cm), the primary proxy for riverbed mineral disturbance. Bottom panel: dissolved oxygen. The Kumbh Mela period (shaded pink, Feb--Mar 2019) and dry season (shaded beige) are marked. Both sensors track each other closely for most variables; the conductivity divergence reflects the Sangam sensor's additional capture of the Yamuna river's mineral load.}}{25}{figure.caption.15}\protected@file@percent }
\newlabel{fig:timeseries_overview}{{14}{25}{Full time-series overview for both sensors (January 2019 to February 2020). Top panel: Water Quality Index (WQI, higher $=$ worse). Middle panel: conductivity ($\mu $S/cm), the primary proxy for riverbed mineral disturbance. Bottom panel: dissolved oxygen. The Kumbh Mela period (shaded pink, Feb--Mar 2019) and dry season (shaded beige) are marked. Both sensors track each other closely for most variables; the conductivity divergence reflects the Sangam sensor's additional capture of the Yamuna river's mineral load}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Monthly water quality at the Ganga (left) and Sangam (right) sensors. Red bars denote dry-season months (Nov--Feb); blue bars denote monsoon-season months. The black line (right axis) plots conductivity ($\mu $S/cm). Both sensors show higher WQI scores (worse quality index) and elevated conductivity during dry-season months, consistent with increased riverbed disturbance when river levels drop and sand becomes accessible.}}{26}{figure.caption.16}\protected@file@percent }
\newlabel{fig:seasonal}{{15}{26}{Monthly water quality at the Ganga (left) and Sangam (right) sensors. Red bars denote dry-season months (Nov--Feb); blue bars denote monsoon-season months. The black line (right axis) plots conductivity ($\mu $S/cm). Both sensors show higher WQI scores (worse quality index) and elevated conductivity during dry-season months, consistent with increased riverbed disturbance when river levels drop and sand becomes accessible}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Left: cross-sensor conductivity scatter plot (monthly Ganga vs.\ Sangam averages, $r = +0.372$). The weaker cross-sensor agreement for conductivity compared to WQI ($r = +0.891$) and DO ($r = +0.973$) reflects the Sangam sensor's additional capture of Yamuna mineral load. Right: daily Ganga conductivity time series with anomaly detection; red points ($|z| > 2$) flag statistical outliers in the series, both positive (high mineral days) and negative (sensor gaps or dilution events).}}{27}{figure.caption.17}\protected@file@percent }
\newlabel{fig:sensor_corr}{{16}{27}{Left: cross-sensor conductivity scatter plot (monthly Ganga vs.\ Sangam averages, $r = +0.372$). The weaker cross-sensor agreement for conductivity compared to WQI ($r = +0.891$) and DO ($r = +0.973$) reflects the Sangam sensor's additional capture of Yamuna mineral load. Right: daily Ganga conductivity time series with anomaly detection; red points ($|z| > 2$) flag statistical outliers in the series, both positive (high mineral days) and negative (sensor gaps or dilution events)}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Current State of the Issue}{27}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Seasonal decomposition of the daily Ganga conductivity time series (additive STL model). Top panel: observed values. Second panel: long-term trend ($+1.37$ $\mu $S/cm/day). Third panel: 30-day seasonal component consistent with tidal backflow modulation. Bottom panel: irregular residuals. The Kumbh Mela period (shaded, Feb--Mar 2019) is excluded from fitting due to exceptional confounding from the mass gathering.}}{28}{figure.caption.18}\protected@file@percent }
\newlabel{fig:decomp}{{17}{28}{Seasonal decomposition of the daily Ganga conductivity time series (additive STL model). Top panel: observed values. Second panel: long-term trend ($+1.37$ $\mu $S/cm/day). Third panel: 30-day seasonal component consistent with tidal backflow modulation. Bottom panel: irregular residuals. The Kumbh Mela period (shaded, Feb--Mar 2019) is excluded from fitting due to exceptional confounding from the mass gathering}{figure.caption.18}{}}
