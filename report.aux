\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces KDE intensity surfaces over India. Left: confirmed mining site density (bandwidth $= 0.08^\circ $), showing two concentration corridors along the Gangetic plains and the Central India plateau. Center: groundwater monitoring station density. Right: mining-to-monitoring ratio, identifying northeastern districts as probable under-detection zones where illegal activity outpaces observational coverage.}}{12}{figure.caption.3}\protected@file@percent }
\newlabel{fig:kde}{{2}{12}{KDE intensity surfaces over India. Left: confirmed mining site density (bandwidth $= 0.08^\circ $), showing two concentration corridors along the Gangetic plains and the Central India plateau. Center: groundwater monitoring station density. Right: mining-to-monitoring ratio, identifying northeastern districts as probable under-detection zones where illegal activity outpaces observational coverage}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Global Moran's I analysis. Left: Moran scatter plot ($I = 0.121$, $p = 0.108$); the positive regression slope indicates mild spatial clustering. Right: state-level choropleth of total mining records showing the Gangetic corridor and Central India plateau as the primary concentration zones.}}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:morans}{{3}{13}{Global Moran's I analysis. Left: Moran scatter plot ($I = 0.121$, $p = 0.108$); the positive regression slope indicates mild spatial clustering. Right: state-level choropleth of total mining records showing the Gangetic corridor and Central India plateau as the primary concentration zones}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces LISA hotspot map ($p < 0.05$, 999 permutations). The red High-High cluster (Goa, Gujarat, Madhya Pradesh, Rajasthan) forms a geographically contiguous belt sharing the Chambal and Narmada river systems. The orange High-Low outlier (Assam) reflects locally specific Brahmaputra basin drivers. Teal Low-High outliers (Chhattisgarh, Jharkhand) sit adjacent to higher-mining neighbours.}}{14}{figure.caption.5}\protected@file@percent }
\newlabel{fig:lisa}{{4}{14}{LISA hotspot map ($p < 0.05$, 999 permutations). The red High-High cluster (Goa, Gujarat, Madhya Pradesh, Rajasthan) forms a geographically contiguous belt sharing the Chambal and Narmada river systems. The orange High-Low outlier (Assam) reflects locally specific Brahmaputra basin drivers. Teal Low-High outliers (Chhattisgarh, Jharkhand) sit adjacent to higher-mining neighbours}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GWR local coefficients for distance-to-nearest-mining-site predicting log(TDS) at 7,190 WRIS groundwater stations. Left: negative (blue/dark) values indicate that proximity to mining correlates with elevated dissolved solids; the signal is concentrated in the Gangetic corridor (Bihar, West Bengal). Right: local $R^2$ surface, confirming that the mining-water quality relationship is strongest along the Ganga and its tributaries.}}{16}{figure.caption.6}\protected@file@percent }
\newlabel{fig:gwr}{{5}{16}{GWR local coefficients for distance-to-nearest-mining-site predicting log(TDS) at 7,190 WRIS groundwater stations. Left: negative (blue/dark) values indicate that proximity to mining correlates with elevated dissolved solids; the signal is concentrated in the Gangetic corridor (Bihar, West Bengal). Right: local $R^2$ surface, confirming that the mining-water quality relationship is strongest along the Ganga and its tributaries}{figure.caption.6}{}}
